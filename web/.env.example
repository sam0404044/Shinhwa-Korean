# 依規格 5.網站技術架構圖：正式環境 MySQL (Linode Managed DB)，開發環境 MySQL (XAMPP 本機)
# 複製此檔為 .env 並填入實際連線字串

# 開發：XAMPP MySQL 預設 (帳號 root、密碼空白、port 3306)
# DATABASE_URL="mysql://root:@localhost:3306/shenhua_korean"

# 開發：若有設定 root 密碼
# DATABASE_URL="mysql://root:你的密碼@localhost:3306/shenhua_korean"

# 正式：Linode Managed MySQL（請向主機商取得連線資訊）
# DATABASE_URL="mysql://使用者:密碼@主機:3306/資料庫名?sslaccept=strict"

# 後台與會員登入 Cookie 簽章密鑰（不同用途使用獨立簽章前綴；至少 32 位隨機字元）
# ADMIN_SESSION_SECRET=replace-with-a-random-secret

# 本機 HTTP 開發可設 false；正式 HTTPS 網域請設 true。
# COOKIE_SECURE=false

# Mux（建立帳號後填入；未設定時仍可在後台手動填寫 Playback ID）
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# 金流（選定藍新或綠界後填入；切勿將正式金鑰提交到 Git）
# PAYMENT_PROVIDER=newebpay
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=

# 社群登入（建立各平台應用程式後填入）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
