// 神話韓語 - 依規格 5.網站技術架構圖
// 正式：MySQL (Linode Managed DB) / 開發：MySQL (XAMPP 本機)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 會員（前台登入）
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String?
  gender          String?
  birthday        DateTime? @db.Date
  phone           String?
  addressRegion   String?   @map("address_region")
  taiwanAddress   String?   @map("taiwan_address")
  overseasAddress String?   @map("overseas_address")
  motivation      String?
  motivationOther String?   @map("motivation_other")
  status          String    @default("active") // active | suspended
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  orders       Order[]
  quizAttempts QuizAttempt[]
}

// 後台管理者
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now()) @map("created_at")
}

// 課程（規格：課程管理、章節/單元、Mux 影片）
model Course {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?  @db.Text
  price         Int      // NT$
  priceOriginal Int?     @map("price_original")
  category      String   // beginner | grammar | speaking | exam
  published     Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  hasTrial      Boolean  @default(false) @map("has_trial")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  chapters      CourseChapter[]
  instructors   InstructorCourse[]
  orders        Order[]
}

// 章節/單元（綁定 Mux Playback ID）
model CourseChapter {
  id             Int     @id @default(autoincrement())
  courseId       Int     @map("course_id")
  title          String
  description    String? @db.Text
  durationMinutes Int?   @map("duration_minutes")
  muxPlaybackId  String? @map("mux_playback_id")
  sortOrder      Int     @default(0) @map("sort_order")
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]
  quizAttempts   QuizAttempt[]
}

model QuizQuestion {
  id           Int           @id @default(autoincrement())
  sourceId     String?       @unique @map("source_id")
  chapterId    Int           @map("chapter_id")
  prompt       String        @db.Text
  options      Json
  correctIndex Int           @map("correct_index")
  explanation  String?       @db.Text
  sortOrder    Int           @default(0) @map("sort_order")
  chapter      CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  chapterId   Int           @map("chapter_id")
  questions   Json
  answers     Json?
  score       Int?
  createdAt   DateTime      @default(now()) @map("created_at")
  submittedAt DateTime?     @map("submitted_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

// 單次購課訂單（金流：藍新/綠界 Webhook 更新狀態）
model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique @map("order_no") // 例 ORD001
  userId    Int      @map("user_id")
  courseId  Int      @map("course_id")
  amount    Int      // NT$
  status    String   @default("pending") // pending | paid | failed | refunded
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

// 文章/最新訊息（規格：文章管理）
model Article {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String?  @db.Text
  content   String?  @db.LongText
  category  String?
  date      DateTime @db.Date
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

// 師資（規格：師資管理、授課課程綁定）
model Instructor {
  id        Int      @id @default(autoincrement())
  name      String
  title     String?
  bio       String?  @db.Text
  avatarUrl String?  @map("avatar_url")
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  courses   InstructorCourse[]
}

model InstructorCourse {
  instructorId Int @map("instructor_id")
  courseId     Int @map("course_id")
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([instructorId, courseId])
}

// 學員見證（規格：學員見證管理、首頁摘要）
model Testimonial {
  id             Int     @id @default(autoincrement())
  name           String
  role           String?
  industry       String?
  quote          String  @db.Text
  quoteShort     String? @map("quote_short") @db.Text
  avatarUrl      String? @map("avatar_url")
  courseRecommend String? @map("course_recommend")
  courseId      Int?     @map("course_id")
  showOnHome    Boolean  @default(false) @map("show_on_home")
  sortOrder     Int      @default(0) @map("sort_order")
}
